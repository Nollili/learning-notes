{
  "name": "node-textbook-task-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.18.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "start": "node --env-file=.env dist/server.js",
    "migrate": "node --env-file=.env dist/migrate.js"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "argon2": "0.44.0",
    "connect-pg-simple": "10.0.0",
    "express": "5.1.0",
    "express-session": "1.18.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "jest": "30.2.0",
    "typescript": "5.9.3"
  },
  "jest": { "testMatch": ["**/checks/*.test.cjs"], "testEnvironment": "node" }
}
